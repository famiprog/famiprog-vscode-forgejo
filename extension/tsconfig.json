{
    "compilerOptions": {
        // Polly's `export default class` types are not seen as classes under Node16.
        "module": "ESNext",
        "target": "ES2020",
        "outDir": "dist",
        "lib": [
            "ESNext",
            "WebWorker"
        ],
        "types": [
            "mocha",
            "node"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true, /* enable all strict type-checking options */
        /* Additional Checks */
        // "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
        // "noFallthroughCasesInSwitch": true, /* Report errors for fallthrough cases in switch statement. */
        // "noUnusedParameters": true,  /* Report errors on unused parameters. */
    },
    // The exclude entry only keeps the page script out of the worker typecheck. It does not stop one folder from importing the other.
    "exclude": [
        "src/web-index-html"
    ]
}
